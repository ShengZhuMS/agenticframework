# Local development against your real Azure resources.
# Copy to .env and fill in. .env is git-ignored.
#
# Everything except KEYVAULT_NAME is optional — the vault supplies the rest.

KEYVAULT_NAME=kv-cortexpoc-a1b2c3

# No Easy Auth in front of a local process, so sign-in is simulated.
# NEVER set these on a deployed environment.
ALLOW_UNAUTHENTICATED=true
LOCAL_DEV_USER=Local developer
LOCAL_DEV_GROUPS=all-staff,operations,analysts

# Entra sends group OBJECT IDs. Map them to the names your access rules use.
# CORTEX_GROUP_NAMES=00000000-1111-2222-3333-444444444444=operations

# Every signed-in user is treated as a member of these groups on top of what
# Entra sends. Default all-staff. Set empty for strict mode.
# CORTEX_DEFAULT_GROUPS=all-staff

# The Ask page. Created in Foundry on first use with FOUNDRY_MODEL.
# ASK_AGENT_NAME=cortex-ask
# ASK_USE_PURVIEW_MCP=false

# Administrator-approved external connector metadata; never put credentials in this JSON.
CORTEX_CONNECTORS=[]
# Fabric data agents require a service principal, not managed identity.
# Store CORTEX_FABRIC_SECRET in a Container Apps secret, not in a committed file.
# Microsoft 365 source connectors additionally require their published Direct Line
# secret reference and matching agentId. See docs/DEPLOY.md section 11.
# Optional existing-model planning for Foundry IQ preview MCP.
# Set both only after approving model usage and Search identity access to this model.
SEARCH_KNOWLEDGE_MODEL_NAME=
SEARCH_KNOWLEDGE_MODEL_ENDPOINT=
