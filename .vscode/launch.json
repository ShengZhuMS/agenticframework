{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cortex: Debug locally",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/bff/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "PORT": "3000",
        "ALLOW_UNAUTHENTICATED": "true",
        "LOCAL_DEV_USER": "Local developer",
        "LOCAL_DEV_GROUPS": "all-staff,waste-crime,analysts"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Cortex: Debug the Purview MCP server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/purview-mcp/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": { "PORT": "3001" },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Cortex: Debug the tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/../../",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--test", "test/"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
