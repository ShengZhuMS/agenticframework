{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cortex: What will be reused?",
      "detail": "Probe which Azure resources exist and whether the pinned model is deployable. Changes nothing.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Deploy-Cortex.ps1",
        "-WhatIfResources"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Deploy to Azure",
      "detail": "Full deployment — provision, deploy, onboard secrets, sign-in, Purview access, bootstrap, verify. Safe to run repeatedly.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Deploy-Cortex.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Cortex: Redeploy code only",
      "detail": "Rebuild and push both images. No infrastructure, no bootstrap. Use after a code change.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Deploy-Cortex.ps1",
        "-AppOnly"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Configure sign-in",
      "detail": "Entra app registration, the groups claim, Container Apps authentication and the default group. Idempotent.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Set-CortexAuth.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Grant Purview access",
      "detail": "Give the Cortex identity its Unified Catalog roles. Fixes 'Purview UNAVAILABLE — 403'. Idempotent.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". ./scripts/Set-CortexEnv.ps1 -Quiet; node scripts/bootstrap.js --only=roles"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Deploy without Key Vault",
      "detail": "Force direct configuration — for a vault with public network access disabled.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Deploy-Cortex.ps1",
        "-ConfigSource",
        "direct"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Upgrade the model",
      "detail": "Move the existing model deployment onto the pinned model and version.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Deploy-Cortex.ps1",
        "-UpgradeModel",
        "-SkipBootstrap"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Reset and start clean",
      "detail": "Delete the Cortex resource group and local azd environment. Prompts for confirmation.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Deploy-Cortex.ps1",
        "-Reset"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Run locally",
      "detail": "Run on this machine against your real Azure resources.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Start-Local.ps1",
        "-Groups",
        "all-staff,waste-crime,analysts"
      ],
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Cortex: Health check",
      "detail": "Check the deployed app, the MCP server and every back end.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Test-Cortex.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Diagnose (paste-able report)",
      "detail": "Health check plus a paste-able block: revisions, replica states, platform and console logs, storage settings, the policies that touched them.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Test-Cortex.ps1",
        "-Diagnose"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Repair storage access (tenant policy lockdown)",
      "detail": "A tenant policy has closed the storage accounts’ public endpoint (bootstrap 403 AuthorizationFailure, cortex-web 404). Exempt, repair, verify.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Set-CortexStorageAccess.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Storage access — report only",
      "detail": "Say which storage setting drifted and which policy did it. Changes nothing.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Set-CortexStorageAccess.ps1",
        "-ReportOnly"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Set up demo identities",
      "detail": "Create and map the demo Entra groups, add you to all of them. Add -DemoUserEmail <address> in a terminal for the second account.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Deploy-Cortex.ps1",
        "-SkipProvision",
        "-SkipBootstrap",
        "-SkipHealthCheck",
        "-DemoIdentities"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Run tests",
      "detail": "The unit suite. No Azure needed.",
      "type": "shell",
      "command": "npm",
      "args": [
        "test"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Cortex: Bootstrap content",
      "detail": "Grant Purview access, then create the Defra governance domains and data products in Purview. Loads config first. Idempotent.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". ./scripts/Set-CortexEnv.ps1; npm run bootstrap"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Bootstrap dry run",
      "detail": "Validate the bootstrap content without writing anything. No Azure and no config needed.",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/bootstrap.js",
        "--dry-run"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Load config into a terminal",
      "detail": "Open a PowerShell terminal with the Cortex configuration loaded, for running bootstrap by hand.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-NoExit",
        "-Command",
        ". ./scripts/Set-CortexEnv.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Bootstrap — Foundry connections for MCP servers",
      "detail": "One Foundry project connection per API Management MCP server, carrying the gateway key. Fixes an agent that cannot sign in to its tools.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". ./scripts/Set-CortexEnv.ps1 -Quiet; node scripts/bootstrap.js --only=connections"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Bootstrap — sample data, Data Map scan, attach assets",
      "detail": "Uploads the synthetic sample files, registers and scans them in the Purview Data Map (3–10 min), attaches the assets to the data products.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". ./scripts/Set-CortexEnv.ps1 -Quiet; node scripts/bootstrap.js --only=data"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Bootstrap — attach scanned assets only",
      "detail": "Run after a scan that was still running when bootstrap finished.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". ./scripts/Set-CortexEnv.ps1 -Quiet; node scripts/bootstrap.js --only=link"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Bootstrap — AI Search indexes",
      "detail": "One Azure AI Search index per data product, built from the sample files, plus the Foundry connection that lets agents read them.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        ". ./scripts/Set-CortexEnv.ps1 -Quiet; node scripts/bootstrap.js --only=search"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Cortex: Sample data — preview",
      "detail": "Show what the synthetic data generator produces, without touching Azure.",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "node scripts/sample-data.js --list"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
